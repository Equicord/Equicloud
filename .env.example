# Server Configuration
SERVER_PORT=9000
SERVER_HOST=0.0.0.0
SERVER_FQDN=http://localhost:9000

# ScyllaDB Configuration
# Set this to your ScyllaDB server URL (e.g., localhost:9042 for local development)
SCYLLA_URI=scylla:9042
# Optional: Set username and password if authentication is enabled (leave empty for no auth)
SCYLLA_USERNAME=
SCYLLA_PASSWORD=

# Logging Configuration
# Set log level: trace, debug, info, warn, error
# Examples: RUST_LOG=debug, RUST_LOG=info, RUST_LOG=equicloud=trace
RUST_LOG=info

# URL that the root of the API will redirect to
# Leave empty for no redirect, or set to your frontend URL
API_ROOT_REDIRECT_URL=https://github.com/Equicord/Equicloud

# Discord OAuth Configuration
# Create a Discord application at https://discord.com/developers/applications
# Get your Client ID and Client Secret from the OAuth2 section
# The redirect URI will be automatically constructed as: {SERVER_FQDN}/v1/oauth/callback
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here

# File Upload Limits
# The maximum settings backup size in bytes. Default is 60MB if not set
MAX_BACKUP_SIZE_BYTES=62914560

# Sync request limits (anti-DoS guards on /v2/sync)
# Maximum number of upload entries in a single sync request. Default: 100000
# MAX_SYNC_UPLOADS=100000
# Maximum number of client_manifest entries in a single sync request. Default: 1000000
# MAX_SYNC_MANIFEST_ENTRIES=1000000

# User Access Control
# You must configure ONE of the two options below, otherwise OAuth will be refused.
#
# Option 1: Whitelist mode (recommended for private deployments)
# Comma-separated list of Discord user IDs that are allowed to use the service.
DISCORD_ALLOWED_USER_IDS=
#
# Option 2: Open registration (public deployments only)
# Set to true to allow any Discord user to authenticate. This must be opted into
# explicitly; an unset/empty whitelist no longer falls back to open registration.
DISCORD_ALLOW_ALL_USERS=false

# Metrics Configuration
# Enable metrics endpoint at /metrics (true/false)
# Default: false (disabled for security)
METRICS_ENABLED=false
# Required when METRICS_ENABLED=true. A long random string (e.g. `openssl rand -hex 32`).
# Scrapers must send `Authorization: Bearer <token>`. If unset while METRICS_ENABLED=true,
# the metrics endpoint stays disabled and an error is logged at startup.
METRICS_TOKEN=

# CORS Configuration
# Comma-separated list of allowed origins for CORS.
# Examples:
#   CORS_ALLOWED_ORIGINS=https://example.com,https://app.example.com
#   CORS_ALLOWED_ORIGINS=* (allow all - insecure, only for development)
# If unset or empty, cross-origin requests will be REJECTED.
CORS_ALLOWED_ORIGINS=

# Rate limiting (governor-based, per source IP)
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_PER_SECOND=50
# RATE_LIMIT_BURST=150
# Set to true if running behind a trusted reverse proxy that sets X-Forwarded-For.
# When false (default), the rate limiter uses the direct peer IP.
# TRUST_PROXY_HEADERS=false

# Compression / datastore feature toggles (optional)
# COMPRESSION_ENABLED=true
# COMPRESSION_LEVEL=3      # zstd 1..=22; out-of-range values are clamped
# DATASTORE_ENABLED=false  # Allow `dataStore/<key>` sync entries

# ScyllaDB driver tuning (optional)
# SCYLLA_POOL_SIZE=4               # connections per shard, must be > 0
# SCYLLA_CONNECTION_TIMEOUT_MS=5000
#
# Keyspace replication strategy (used only when the keyspace does NOT yet exist).
# Default is SimpleStrategy with rf=1, suitable for single-node dev.
# For multi-DC production use, set something like:
#   SCYLLA_KEYSPACE_REPLICATION={'class': 'NetworkTopologyStrategy', 'dc1': 3}
# SCYLLA_KEYSPACE_REPLICATION={'class': 'SimpleStrategy', 'replication_factor': 1}
